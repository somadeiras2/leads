# ==========================================
# GRUPOLEADS — Configuração de Ambiente (.env)
# ==========================================

# 1. Banco de Dados (Supabase PostgreSQL ou Local SQLite)
# Para Supabase (Recomendado na Nuvem):
DATABASE_URL="postgresql://postgres:[SUA_SENHA]@db.[SEU_PROJETO].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[SUA_SENHA]@db.[SEU_PROJETO].supabase.co:5432/postgres"

# Para SQLite Local (Desenvolvimento):
# DATABASE_URL="file:./dev.db"

# 2. Servidor e API
PORT=3001
NODE_ENV=production
CORS_ORIGIN=*

# 3. Segurança & Autenticação JWT
JWT_SECRET="grupoleads_super_secret_jwt_key_2026_production_ready"

# 4. Frontend Dashboard (Vercel)
# Na Vercel, defina esta variável de ambiente:
# VITE_API_URL="https://sua-api-grupoleads.onrender.com/api"
